# Celeste Pharma Cold-Chain Example — Environment Template
# ==========================================================
# Copy this file to .env and fill in your values.
#
#   cp .env.example .env
#
# At minimum, set ANTHROPIC_API_KEY or OPENAI_API_KEY.

# Anthropic API key (Claude models)
ANTHROPIC_API_KEY=sk-ant-

# OpenAI API key (GPT models, optional)
OPENAI_API_KEY=sk-

# Database connection string
DATABASE_URL=postgresql+asyncpg://celeste:celeste@localhost:5432/pharma_coldchain

# Redis connection string
REDIS_URL=redis://localhost:6379/0

# Environment: local or production
ENVIRONMENT=local
