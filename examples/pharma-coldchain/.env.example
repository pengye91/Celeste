# Celeste Pharma Cold-Chain Example — Environment Template
# ==========================================================
# Copy this file to .env and fill in your values.
#
#   cp .env.example .env
#
# The engine only reads LLM_API_KEY (a single key shared across all
# supported providers: anthropic, openai, gemini, ollama). Set
# LLM_PROVIDER to pick the active provider.

# Provider-agnostic API key (the only one the engine reads)
LLM_API_KEY=sk-

# Provider selection: anthropic | openai | gemini | ollama
LLM_PROVIDER=anthropic

# Database connection string
DATABASE_URL=postgresql+asyncpg://celeste:celeste@localhost:5432/pharma_coldchain

# Redis connection string
REDIS_URL=redis://localhost:6379/0

# Environment: local or production
ENVIRONMENT=local